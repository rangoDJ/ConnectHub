# ==============================================================================
# ConnectHub Environment Configuration
# Copy this file to .env and adjust values for your environment
# ==============================================================================

# ----------------- Authentication Mode -----------------
# Choose one of: none, basic, oidc, forward_auth
AUTH_MODE=none

# ----------------- Option 1: Basic Authentication -----------------
# Used when AUTH_MODE=basic. There is no default account: the first visitor to the
# login page creates one. Accounts are stored in /config/users.json.
# Set to true to let others create more accounts from the login page.
ALLOW_SIGNUPS=false

# ----------------- Option 2: Authentik / OIDC SSO -----------------
# Used when AUTH_MODE=oidc
# 1. In Authentik, create an OAuth2/OpenID Provider:
#    - Client type: Confidential
#    - Redirect URIs: http://<your-server-ip-or-domain>:8080/auth/callback
#    - Scopes: openid email profile
# 2. In Authentik, create an Application attached to that Provider
OIDC_ISSUER_URL=https://authentik.yourdomain.com/application/o/connecthub/
OIDC_CLIENT_ID=your_authentik_client_id
OIDC_CLIENT_SECRET=your_authentik_client_secret
OIDC_REDIRECT_URI=http://localhost:8080/auth/callback
# Verify the provider's TLS certificate. Only set false for self-signed test setups.
OIDC_VERIFY_SSL=true

# ----------------- Option 3: Authentik Forward Auth / Proxy Outpost -----------------
# Used when AUTH_MODE=forward_auth (behind Authentik Proxy Outpost, Traefik, or Authelia)
FORWARD_AUTH_HEADER=X-authentik-username
# REQUIRED for forward_auth: comma-separated IPs/CIDRs of your reverse proxy.
# The header is ignored from any other address, so clients can't forge it.
FORWARD_AUTH_TRUSTED_PROXIES=172.18.0.0/16

# ----------------- Session Cookie -----------------
# Secure flag on the session cookie: auto (set when accessed via https), true, false
COOKIE_SECURE=auto

# ----------------- Session Security Key -----------------
# Optional: Random 32+ character hex string for signing session cookies
# If left empty, a persistent key will be generated inside /config/.session_secret
# SECRET_KEY=

# ----------------- Video & Audio Streaming -----------------
# h264enc uses the GPU when one is passed to the container, otherwise x264 on the CPU
SELKIES_ENCODER=h264enc

# ----------------- GPU Configuration (Optional) -----------------
# For AMD Radeon or Intel GPUs (Uncomment and pass /dev/dri in docker-compose.yml):
# DRINODE=/dev/dri/renderD128
# DRI_NODE=/dev/dri/renderD128

# For NVIDIA GPUs:
# NVIDIA_VISIBLE_DEVICES=all
# NVIDIA_DRIVER_CAPABILITIES=all

# GPU selection: true (auto), false, or a vendor: nvidia, amdgpu, intel
# AUTO_GPU=true

# Force CPU encoding even when a GPU is available
# SELKIES_USE_CPU=true
